# Master artwork and unreferenced images live in the repo but are not part of
# the deployed site.
exclude_from_upload:
  - assets/images/Source/.*
  - assets/images/aeronalfrey121\.jpg
  - assets/images/baphomet\.jpg
  - assets/images/helvete\.jpg
  - assets/images/Pope\.jpg
  - assets/images/symbel_band\.jpg
  - assets/images/symbel_forests_sized2\.jpg
